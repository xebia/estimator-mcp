@page "/"

<PageTitle>Catalog Editor</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Catalog Editor</h1>
        <p>Welcome back, <strong>@context.User.Identity?.Name</strong>.</p>

        <div class="row mt-4">
            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><span class="bi bi-stack"></span> Tech Stacks</h5>
                        <p class="card-text">Manage technology stacks and their associated roles.</p>
                        <a href="/techstacks" class="btn btn-primary">Manage Tech Stacks</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><span class="bi bi-people-fill"></span> Roles</h5>
                        <p class="card-text">Manage implementation roles with Copilot productivity multipliers.</p>
                        <a href="/roles" class="btn btn-primary">Manage Roles</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><span class="bi bi-list-nested-nav-menu"></span> Catalog</h5>
                        <p class="card-text">Map features to role estimates using t-shirt sizing.</p>
                        <a href="/catalog" class="btn btn-primary">Manage Catalog</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><span class="bi bi-key-fill"></span> API Keys</h5>
                        <p class="card-text">Request an API key to use the MCP Estimator server.</p>
                        <button class="btn btn-outline-secondary" disabled>Coming Soon</button>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="text-center py-5">
            <h1 class="display-5 fw-bold">MCP Estimator Catalog Editor</h1>
            <p class="lead text-muted mt-3">
                Manage your project estimation catalog for AI-powered effort estimation.
            </p>
            <div class="mt-4">
                <a href="/account/login" class="btn btn-primary btn-lg me-2">Sign In</a>
                <a href="/account/register" class="btn btn-outline-secondary btn-lg">Register</a>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-md-4 mb-3">
                <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                        <span class="bi bi-list-nested-nav-menu fs-2 text-primary"></span>
                        <h6 class="mt-2">Estimation Catalog</h6>
                        <p class="small text-muted">Define features and t-shirt size estimates per role.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                        <span class="bi bi-robot fs-2 text-primary"></span>
                        <h6 class="mt-2">AI-Powered</h6>
                        <p class="small text-muted">Served via MCP to LLM agents for intelligent estimation.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card h-100 border-0 bg-light">
                    <div class="card-body text-center">
                        <span class="bi bi-people-fill fs-2 text-primary"></span>
                        <h6 class="mt-2">Role-Based Estimates</h6>
                        <p class="small text-muted">Per-role hour breakdowns with Copilot productivity multipliers.</p>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
