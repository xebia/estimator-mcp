@page "/account/verify"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CatalogEditor.Services.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IVerificationService VerificationService
@inject ILogger<Verify> Logger
@inject IdentityRedirectManager RedirectManager
@inject IOptions<AzureEmailOptions> EmailOptions

<PageTitle>Enter Code — Catalog Editor</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 420px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h4 class="fw-bold">Check Your Email</h4>
                <p class="text-muted small">
                    We sent a 6-digit code to <strong>@Email</strong>.
                    Enter it below to sign in.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="Input" OnValidSubmit="VerifyCode" FormName="verify" method="post">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="code">6-digit code</label>
                    <InputText id="code" @bind-Value="Input.Code" class="form-control text-center fs-4 letter-spacing-wide"
                               autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="······" />
                    <ValidationMessage For="() => Input.Code" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign In</button>
            </EditForm>

            <div class="alert alert-light mt-3 small">
                <strong>Didn't get the email?</strong> Check your spam folder.
                @if (!string.IsNullOrEmpty(SenderAddress))
                {
                    <span> The email will come from <code>@SenderAddress</code>.</span>
                }
                <br />
                <a href="/account/login">Send a new code</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private string SenderAddress => EmailOptions.Value.SenderAddress;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
#pragma warning restore BL0008

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task VerifyCode()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            RedirectManager.RedirectTo("/account/login");
            return;
        }

        var valid = await VerificationService.ValidateCodeAsync(Email, Input.Code.Trim());

        if (!valid)
        {
            errorMessage = "Invalid or expired code. Please try again or request a new one.";
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.Name, Email),
            new(ClaimTypes.Email, Email),
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            principal,
            new AuthenticationProperties
            {
                IsPersistent = true,
                ExpiresUtc = DateTimeOffset.UtcNow.AddDays(7)
            });

        Logger.LogInformation("User {Email} signed in successfully", Email);
        RedirectManager.RedirectTo(ReturnUrl ?? "/");
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "Enter the 6-digit code.")]
        public string Code { get; set; } = "";
    }
}
